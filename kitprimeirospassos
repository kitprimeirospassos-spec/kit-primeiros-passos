<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kit Primeiros Passos: 30 dias de atividades para seu filho começar a ler</title>
<meta name="description" content="30 dias de atividades para imprimir, com letras, sílabas e palavras. Método de 10 minutos por dia para crianças de 4 a 7 anos.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --sky:#2F9DF0; --sky-light:#6CC3FA; --sky-soft:#DDF2FF;
  --sun:#FFC93C; --sun-bg:#FFD84F;
  --coral:#F5524A; --coral-soft:#FFE4DB;
  --leaf:#12905D; --teal:#17A58F;
  --navy:#14224A;
  --paper:#FFF8E6; --card:#FFFFFF; --ink:#14224A; --ink-soft:#3F4D78;
  --display:'Baloo 2','Arial Rounded MT Bold','Trebuchet MS',system-ui,sans-serif;
  --body:'Nunito','Segoe UI',system-ui,-apple-system,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0E1736; --card:#1B2757; --ink:#FFF1D0; --ink-soft:#BAC4E8;
  }
}
:root[data-theme="dark"]{
  --paper:#0E1736; --card:#1B2757; --ink:#FFF1D0; --ink-soft:#BAC4E8;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px);-webkit-text-size-adjust:100%}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);font-size:18px;line-height:1.55;overflow-x:clip}
img{max-width:100%;display:block}
h1,h2,h3{font-family:var(--display);line-height:1.04;margin:0;font-weight:800}
h2{font-size:clamp(30px,7.4vw,50px);text-wrap:balance}
h3{font-size:clamp(22px,5vw,28px)}
p{margin:0}
a{color:inherit}
.wrap{width:min(1120px,100% - 40px);margin-inline:auto}
.center{text-align:center}
.lead{font-size:clamp(18px,4.4vw,21px);color:var(--ink-soft);max-width:60ch}
.center .lead{margin-inline:auto}

/* ---------- section colours (tokens re-scoped so dark mode never breaks coloured sections) ---------- */
.sec{position:relative;padding:48px 0 56px}
.sec-paper{background:var(--paper);color:var(--ink)}
.sec-sun{--card:#fff;--ink:#14224A;--ink-soft:#3A4670;background:var(--sun-bg);color:#14224A}
.sec-sky{--card:#fff;--ink:#14224A;--ink-soft:#3A4670;background:var(--sky);color:#fff}
.sec-soft{--card:#fff;--ink:#14224A;--ink-soft:#3A4670;background:var(--sky-soft);color:#14224A}
.sec-peach{--card:#fff;--ink:#14224A;--ink-soft:#3A4670;background:var(--coral-soft);color:#14224A}
.sec-coral{--card:#fff;--ink:#14224A;--ink-soft:#3A4670;background:var(--coral);color:#fff}
.sec-navy{--ink:#FFF1D0;background:var(--navy);color:#FFF1D0}

.wave{display:block;line-height:0;background:var(--from);position:relative;z-index:1}
.wave svg{display:block;width:100%;height:clamp(26px,5vw,58px);fill:var(--to)}

/* ---------- shared bits ---------- */
.sticker{background:var(--card);border:3px solid var(--navy);border-radius:26px 18px 28px 20px;box-shadow:5px 7px 0 var(--navy);color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:58px;padding:12px 30px;border-radius:999px;background:var(--leaf);color:#fff;
  font-family:var(--display);font-weight:800;font-size:clamp(19px,4.8vw,23px);line-height:1.1;text-decoration:none;text-align:center;
  border:3px solid var(--navy);box-shadow:0 6px 0 var(--navy);transition:transform .12s ease,box-shadow .12s ease}
.btn:hover{transform:translateY(2px);box-shadow:0 4px 0 var(--navy)}
.btn:active{transform:translateY(6px);box-shadow:0 0 0 var(--navy)}
.btn:focus-visible,.chip:focus-visible,.arrow:focus-visible,summary:focus-visible{outline:4px solid var(--sun);outline-offset:3px}
.btn-big{min-height:66px;padding:14px 38px;font-size:clamp(20px,5.2vw,26px)}
.checks{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px 18px;font-weight:700;font-size:16px}
.checks li{display:flex;align-items:center;gap:8px}
.checks svg{width:22px;height:22px;flex:none}
.paper{background:#fff;padding:7px;border-radius:6px;box-shadow:0 2px 0 rgba(20,34,74,.12),0 14px 28px rgba(20,34,74,.28)}
.paper img{width:100%;height:auto;border-radius:2px;aspect-ratio:1122/1402}

/* ---------- top bar ---------- */
.topbar{background:var(--navy);color:#fff;text-align:center;font-weight:800;font-size:15px;padding:9px 16px;padding-top:calc(9px + env(safe-area-inset-top,0px))}
.topbar b{color:var(--sun);white-space:nowrap}

/* ---------- hero ---------- */
.hero{background:linear-gradient(180deg,var(--sky) 0%,var(--sky-light) 100%);color:#fff;padding:34px 0 20px;overflow:hidden;position:relative;contain:paint}
.hero .deco{position:absolute;pointer-events:none}
.hero .sun{width:min(34vw,190px);right:-28px;top:-24px}
.hero .cloud-a{width:150px;left:-30px;top:92px;opacity:.95}
.hero .cloud-b{width:120px;right:-20px;bottom:150px;opacity:.9}
.hero-grid{display:grid;gap:34px;align-items:center;position:relative}
.pill{display:inline-block;background:#fff;color:var(--navy);font-weight:800;font-size:15px;padding:6px 16px;border:3px solid var(--navy);border-radius:999px;box-shadow:3px 4px 0 var(--navy);margin-bottom:18px}
.hero h1{font-size:clamp(34px,9.6vw,60px);color:#fff;-webkit-text-stroke:9px var(--navy);paint-order:stroke fill;text-shadow:0 6px 0 var(--navy);letter-spacing:.005em;text-wrap:balance}
.hero .sub{margin:24px 0 26px;font-size:clamp(18px,4.6vw,21px);font-weight:600;color:var(--navy);background:#fff;border:3px solid var(--navy);border-radius:20px;padding:14px 18px;box-shadow:4px 5px 0 var(--navy);max-width:34em}
.hero .checks{margin-top:26px;color:#fff;text-shadow:0 2px 0 rgba(20,34,74,.55)}
.hero .checks svg{filter:drop-shadow(0 2px 0 rgba(20,34,74,.55))}

.stack{position:relative;width:min(76vw,400px);margin:10px auto 6px;aspect-ratio:4/5.15}
.stack .paper{position:absolute}
.stack .front{width:80%;left:10%;top:3%;z-index:3;transform:rotate(-2deg)}
.stack .left{width:62%;left:-13%;top:12%;z-index:1;transform:rotate(-9deg)}
.stack .right{width:62%;right:-13%;top:16%;z-index:2;transform:rotate(8deg)}
.burst{position:absolute;right:-9%;bottom:6%;width:34%;min-width:118px;z-index:5;transform:rotate(8deg)}
.burst svg{width:100%;height:auto;display:block}
.burst span{position:absolute;inset:0;display:grid;place-content:center;text-align:center;font-family:var(--display);font-weight:800;color:var(--navy);line-height:1}
.burst small{font-size:clamp(12px,3.2vw,15px);font-weight:700}
.burst b{font-size:clamp(20px,5.4vw,27px)}
.pencil{position:absolute;left:-16%;bottom:-2%;width:60%;z-index:4;transform:rotate(-14deg);filter:drop-shadow(0 6px 0 rgba(20,34,74,.35))}

@media (prefers-reduced-motion: no-preference){
  .stack .left{animation:fanL .9s .15s cubic-bezier(.2,.9,.3,1.2) both}
  .stack .right{animation:fanR .9s .25s cubic-bezier(.2,.9,.3,1.2) both}
  .burst{animation:pop .6s .9s cubic-bezier(.2,1.6,.4,1) both}
}
@keyframes fanL{from{transform:translateX(52%) rotate(0)}to{transform:rotate(-9deg)}}
@keyframes fanR{from{transform:translateX(-52%) rotate(0)}to{transform:rotate(8deg)}}
@keyframes pop{from{transform:scale(.2) rotate(-20deg);opacity:0}to{transform:rotate(8deg);opacity:1}}

/* ---------- pains ---------- */
.pains{display:grid;gap:22px;margin:34px 0 8px}
.pain{padding:20px 22px 22px}
.pain h3{margin-bottom:6px}
.pain p{color:var(--ink-soft);font-weight:600}
.pain:nth-child(1){background:#FFE6A3;--ink-soft:#3A4670;--ink:#14224A;transform:rotate(-1deg)}
.pain:nth-child(2){background:#CDEBFF;--ink-soft:#3A4670;--ink:#14224A;transform:rotate(.8deg)}
.pain:nth-child(3){background:#FFD3CC;--ink-soft:#3A4670;--ink:#14224A;transform:rotate(.6deg)}
.pain:nth-child(4){background:#C7F1E2;--ink-soft:#3A4670;--ink:#14224A;transform:rotate(-.8deg)}
.bridge{margin:46px auto 0}
.bridge h2{max-width:15em;margin-inline:auto}
.bridge h2{font-size:clamp(32px,8vw,56px)}
.bridge p{margin:16px 0 26px}
.jelly span{display:inline-block}
.jelly span:nth-child(5n+1){color:var(--coral)}
.jelly span:nth-child(5n+2){color:#2F8FE0}
.jelly span:nth-child(5n+3){color:#12905D}
.jelly span:nth-child(5n+4){color:#E59A00}
.jelly span:nth-child(5n+5){color:var(--navy)}

/* ---------- kit ---------- */
.kit-grid{display:grid;gap:44px;margin-top:40px}
.kit-item{text-align:center}
.kit-item .paper{width:min(72%,290px);margin:0 auto 22px}
.kit-item:nth-child(1) .paper{transform:rotate(-4deg)}
.kit-item:nth-child(2) .paper{transform:rotate(2deg)}
.kit-item:nth-child(3) .paper{transform:rotate(-2deg)}
.kit-item p{margin:8px auto 0;max-width:24em;font-weight:600;color:var(--ink-soft)}

/* ---------- gallery ---------- */
.gallery{display:grid;grid-template-columns:minmax(0,1fr);gap:30px;margin-top:32px;justify-items:center}
.gallery>*{min-width:0;max-width:100%}
.tablet{width:min(88vw,400px);background:var(--navy);border-radius:34px;padding:16px 14px 20px;box-shadow:0 22px 40px rgba(10,20,60,.45),inset 0 0 0 3px #2A3A72;position:relative}
.tablet::before{content:"";position:absolute;top:6px;left:50%;width:7px;height:7px;margin-left:-3.5px;border-radius:50%;background:#3C4E8E}
.screen{border-radius:14px;overflow:hidden;background:#fff;margin-top:6px}
.screen img{width:100%;height:auto;aspect-ratio:1122/1402;transition:opacity .12s ease}
.caption{margin-top:12px;text-align:center;color:#fff;font-family:var(--display);font-weight:700;font-size:21px;min-height:1.4em}
.controls{display:flex;align-items:center;gap:10px;width:100%;max-width:960px;min-width:0}
.arrow{flex:none;width:52px;height:52px;border-radius:50%;background:#fff;color:var(--navy);border:3px solid var(--navy);box-shadow:0 4px 0 var(--navy);cursor:pointer;display:grid;place-content:center}
.arrow svg{width:22px;height:22px}
.arrow:active{transform:translateY(3px);box-shadow:0 1px 0 var(--navy)}
.chips{display:flex;gap:10px;overflow-x:auto;padding:6px 4px 12px;scroll-snap-type:x proximity;scrollbar-width:thin;flex:1;min-width:0}
.chip{flex:none;scroll-snap-align:center;min-height:46px;padding:6px 16px;border-radius:999px;border:3px solid var(--navy);background:#fff;color:var(--navy);font-family:var(--display);font-weight:800;font-size:17px;cursor:pointer;box-shadow:0 3px 0 var(--navy)}
.chip[aria-pressed="true"]{background:var(--sun);transform:translateY(2px);box-shadow:0 1px 0 var(--navy)}

/* ---------- anatomy ---------- */
.anat{display:grid;gap:36px;margin-top:36px;align-items:center}
.anat-img{position:relative;width:min(84vw,400px);margin:0 auto}
.pin{position:absolute;left:-14px;width:38px;height:38px;border-radius:50%;display:grid;place-content:center;font-family:var(--display);font-weight:800;font-size:21px;color:#fff;border:3px solid var(--navy);box-shadow:2px 3px 0 var(--navy);line-height:1}
.pin.p1{top:30%;background:var(--coral)}
.pin.p2{top:50%;background:#2F8FE0}
.pin.p3{top:71%;background:var(--leaf)}
.pin.p4{top:90%;background:var(--sun);color:var(--navy)}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:18px}
.steps li{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start}
.steps .n{width:44px;height:44px;border-radius:50%;display:grid;place-content:center;font-family:var(--display);font-weight:800;font-size:23px;color:#fff;border:3px solid var(--navy);box-shadow:2px 3px 0 var(--navy);line-height:1}
.steps li:nth-child(1) .n{background:var(--coral)}
.steps li:nth-child(2) .n{background:#2F8FE0}
.steps li:nth-child(3) .n{background:var(--leaf)}
.steps li:nth-child(4) .n{background:var(--sun);color:var(--navy)}
.steps h3{font-size:clamp(21px,5vw,26px);margin-bottom:2px}
.steps p{color:var(--ink-soft);font-weight:600}
.note{margin-top:22px;font-weight:700;color:var(--ink);background:#FFE6A3;color:#14224A;border:3px dashed var(--navy);border-radius:16px;padding:12px 16px}

/* ---------- method ---------- */
.method{display:grid;gap:40px;margin-top:32px;align-items:center}
.timebar{display:flex;height:74px;border:3px solid var(--navy);border-radius:20px;overflow:hidden;box-shadow:4px 6px 0 var(--navy);background:#fff}
.timebar div{display:grid;place-content:center;color:#fff;font-family:var(--display);font-weight:800;line-height:1;text-align:center}
.timebar b{font-size:clamp(26px,7vw,36px)}
.timebar small{font-size:14px;font-weight:700}
.timebar .t5{flex:5;background:var(--coral)}
.timebar .t3{flex:3;background:#2F8FE0}
.timebar .t2{flex:2;background:var(--leaf)}
.legend{list-style:none;margin:22px 0 0;padding:0;display:grid;gap:10px;font-weight:700}
.legend li{display:flex;gap:12px;align-items:center}
.legend i{flex:none;width:18px;height:18px;border-radius:50%;border:3px solid var(--navy)}
.legend li:nth-child(1) i{background:var(--coral)}
.legend li:nth-child(2) i{background:#2F8FE0}
.legend li:nth-child(3) i{background:var(--leaf)}
.how{margin:26px 0 0;padding:0;list-style:none;display:grid;gap:8px;color:var(--ink-soft);font-weight:600}
.how li{display:flex;gap:10px;align-items:flex-start}
.how svg{width:22px;height:22px;flex:none;margin-top:3px}
.method .paper{width:min(78vw,340px);margin:0 auto;transform:rotate(2.5deg)}

/* ---------- journey + calendar ---------- */
.journey{display:flex;gap:18px;overflow-x:auto;padding:26px 6px 26px;margin:20px -20px 0;padding-inline:20px;scroll-snap-type:x mandatory;scrollbar-width:thin}
.stop{flex:none;width:176px;scroll-snap-align:center;text-align:center}
.stop .paper{width:100%}
.stop:nth-child(odd) .paper{transform:rotate(-2.5deg)}
.stop:nth-child(even) .paper{transform:rotate(2.5deg)}
.stop b{display:block;margin-top:14px;font-family:var(--display);font-size:20px;line-height:1.1}
.stop span{font-weight:700;font-size:15px;color:var(--ink-soft)}
.stop.locked img{filter:blur(3px) saturate(.9)}
.stop .paper{position:relative}
.lock{position:absolute;inset:0;display:grid;place-content:center}
.lock svg{width:64px;height:64px;filter:drop-shadow(0 3px 0 rgba(20,34,74,.5))}
.gallery-note{margin-top:4px;font-weight:700;color:#fff;max-width:34em}
.calendar{display:grid;gap:36px;margin-top:40px;align-items:center}
.taped{position:relative;width:min(76vw,320px);margin:0 auto;transform:rotate(-3deg)}
.taped::before,.taped::after{content:"";position:absolute;top:-14px;width:78px;height:26px;background:rgba(255,200,60,.82);box-shadow:0 2px 0 rgba(20,34,74,.12);z-index:2}
.taped::before{left:-22px;transform:rotate(-38deg)}
.taped::after{right:-22px;transform:rotate(38deg)}

/* ---------- bonus ---------- */
.bonus-grid{display:grid;gap:22px;margin-top:26px}
.bonus-feature+.bonus-feature{margin-top:30px}
.bonus-feature{display:grid;gap:26px;padding:26px 22px 30px;align-items:center;margin-top:34px;text-align:left}
.bonus-feature .paper{width:min(74vw,290px);margin:0 auto;transform:rotate(-2.5deg)}
.bonus-feature h3{font-size:clamp(26px,6vw,34px);margin:10px 0 8px}
.bonus-feature p{color:var(--ink-soft);font-weight:600}
.mini{position:relative;width:min(74vw,290px);margin:0 auto;aspect-ratio:4/5.15}
.mini .paper{position:absolute}
.mini .ft{width:82%;left:9%;top:2%;z-index:3;transform:rotate(-2deg)}
.mini .bk{width:70%;z-index:1}
.mini .bk.l{left:-8%;top:9%;transform:rotate(-9deg)}
.mini .bk.r{right:-8%;top:11%;transform:rotate(8deg);z-index:2}
.mini .bk img{filter:blur(3px) saturate(.9)}
.tag{display:inline-block;background:var(--sun);color:var(--navy);font-family:var(--display);font-weight:800;font-size:17px;padding:2px 16px;border:3px solid var(--navy);border-radius:999px;box-shadow:2px 3px 0 var(--navy)}
.inside{list-style:none;margin:18px 0 0;padding:0;display:grid;gap:9px;font-weight:700}
.inside li{display:flex;gap:10px;align-items:flex-start}
.inside svg{width:22px;height:22px;flex:none;margin-top:2px}
.bonus{padding:26px 22px;text-align:center;border-style:dashed;box-shadow:none;background:transparent}
.bonus svg{width:74px;height:74px;margin:0 auto 10px}
.bonus h3{margin-bottom:6px}
.bonus p{color:var(--ink-soft);font-weight:600}

/* ---------- offer ---------- */
.offer{padding:30px 22px 34px;max-width:560px;margin:30px auto 0;text-align:center}
.offer h3{font-size:clamp(26px,6vw,34px)}
.offer ul{list-style:none;padding:0;margin:20px 0 6px;display:grid;gap:11px;text-align:left;font-weight:700}
.offer li{display:flex;gap:10px;align-items:flex-start}
.offer li svg{width:24px;height:24px;flex:none;margin-top:2px}
.offer .price{margin:24px 0 2px;font-family:var(--display);font-weight:800;line-height:.95;color:var(--coral)}
.offer .price small{display:block;font-size:20px;color:var(--ink-soft);font-weight:700;margin-bottom:4px}
.offer .price b{font-size:clamp(68px,20vw,96px)}
.offer .per{font-weight:700;color:var(--ink-soft);margin-bottom:22px}
.offer .btn{width:100%}
.offer .fine{margin-top:14px;font-size:15px;font-weight:700;color:var(--ink-soft)}

/* ---------- guarantee ---------- */
.guar{display:grid;gap:22px;justify-items:center;text-align:center;max-width:720px;margin:0 auto}
.seal{width:130px;height:130px}

/* ---------- faq ---------- */
.faq{display:grid;gap:14px;max-width:780px;margin:34px auto 0}
details{background:#fff;border:3px solid var(--navy);border-radius:20px;box-shadow:4px 5px 0 var(--navy);color:#14224A}
summary{list-style:none;cursor:pointer;padding:16px 56px 16px 20px;font-family:var(--display);font-weight:700;font-size:clamp(19px,4.6vw,22px);line-height:1.2;position:relative;min-height:56px;display:flex;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";position:absolute;right:16px;top:50%;width:30px;height:30px;margin-top:-15px;border-radius:50%;background:var(--sun);border:3px solid var(--navy);display:grid;place-content:center;font-size:22px;line-height:1;font-weight:800;transition:transform .2s ease}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 20px 18px;font-weight:600;color:#3A4670}

/* ---------- final ---------- */
.final{background:linear-gradient(180deg,var(--sky) 0%,var(--sky-light) 100%);color:#fff;text-align:center;overflow:hidden;position:relative;padding:50px 0 60px}
.final h2{-webkit-text-stroke:8px var(--navy);paint-order:stroke fill;text-shadow:0 5px 0 var(--navy);font-size:clamp(34px,9vw,60px)}
.final p{margin:20px auto 28px;font-weight:700;font-size:20px;color:var(--navy);background:#fff;border:3px solid var(--navy);border-radius:18px;padding:10px 18px;display:inline-block;box-shadow:4px 5px 0 var(--navy);max-width:28em}
.final .deco{position:absolute;pointer-events:none}
.final .cloud-a{width:140px;left:-30px;top:50px}
.final .cloud-b{width:120px;right:-24px;bottom:60px}
.foot{padding:30px 0 40px;font-size:14.5px;text-align:center;color:#C9D3F5}
.foot p+p{margin-top:8px}

/* ---------- sticky bar ---------- */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--navy);padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));display:flex;gap:14px;align-items:center;justify-content:center;transform:translateY(110%);transition:transform .25s ease;box-shadow:0 -6px 20px rgba(0,0,0,.25)}
.sticky.show{transform:none}
.sticky .p{color:#fff;font-family:var(--display);font-weight:800;line-height:1;font-size:26px}
.sticky .p small{display:block;font-size:12px;font-weight:700;color:#BFD0FF}
.sticky .btn{min-height:50px;padding:8px 22px;font-size:19px;box-shadow:0 4px 0 #000}
@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}.sticky,.screen img,summary::after{transition:none}}

/* ---------- desktop ---------- */
@media (min-width:760px){
  .sec{padding:70px 0 80px}
  .pains{grid-template-columns:1fr 1fr;gap:28px}
  .kit-grid{grid-template-columns:repeat(3,1fr);gap:30px}
  .bonus-grid{grid-template-columns:repeat(2,1fr)}
