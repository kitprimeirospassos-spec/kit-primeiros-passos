<script>
const IMGS = {"capa": "data:image/webp;base64,", "guia": "data:image/webp;base64,", "cal": "data:image/webp;base64,", "d1": "data:image/webp;base64,", "d2": "data:image/webp;base64,", "d3": "data:image/webp;base64,", "d4": "data:image/webp;base64,", "caderno": "data:image/webp;base64,", "vogais": "data:image/webp;base64,", "m1": "data:image/webp;base64,", "bAlfa": "data:image/webp;base64,", "bPal": "data:image/webp;base64,", "bM3": "data:image/webp;base64,", "bM5": "data:image/webp;base64,", "b12": "data:image/webp;base64,", "b21": "data:image/webp;base64,", "b26": "data:image/webp;base64,", "b30": "data:image/webp;base64,"};

/* ====== LINK DE CHECKOUT (Kiwify) ====== */
const CHECKOUT_URL = "https://pay.kiwify.com.br/BkxDnuV";

(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // imagens
  document.querySelectorAll('img[data-img]').forEach(function(el){ el.src = IMGS[el.dataset.img]; });

  // botões de compra
  document.querySelectorAll('[data-checkout]').forEach(function(a){ a.href = CHECKOUT_URL; });

  // galeria
  var pages = [
    ['guia','Guia','Guia de boas-vindas'],
    ['d1','Dia 1','Dia 1 · Vogal A'],['d2','Dia 2','Dia 2 · Vogal E'],['d3','Dia 3','Dia 3 · Vogal I'],['d4','Dia 4','Dia 4 · Vogal O']
  ];
  var stage = document.getElementById('stage'), cap = document.getElementById('cap'), chips = document.getElementById('chips');
  var cur = 1, btns = [];
  pages.forEach(function(p,i){
    var b = document.createElement('button');
    b.type='button'; b.className='chip'; b.textContent=p[1];
    b.setAttribute('aria-pressed','false'); b.setAttribute('aria-label','Ver '+p[2]);
    b.addEventListener('click', function(){ show(i,true); });
    chips.appendChild(b); btns.push(b);
  });
  function show(i, scroll){
    cur = (i + pages.length) % pages.length;
    var p = pages[cur];
    function apply(){ stage.src = IMGS[p[0]]; stage.alt = p[2]; stage.style.opacity = 1; }
    if (reduce) { apply(); } else { stage.style.opacity = 0; setTimeout(apply, 110); }
    cap.textContent = p[2];
    btns.forEach(function(b,k){ b.setAttribute('aria-pressed', k===cur ? 'true':'false'); });
    if (scroll !== false) {
      var b = btns[cur], c = chips;
      c.scrollTo({left: b.offsetLeft - c.clientWidth/2 + b.clientWidth/2, behavior: reduce ? 'auto':'smooth'});
    }
  }
  document.getElementById('prev').addEventListener('click', function(){ show(cur-1,true); });
  document.getElementById('next').addEventListener('click', function(){ show(cur+1,true); });
  stage.src = IMGS[pages[cur][0]]; stage.alt = pages[cur][2]; cap.textContent = pages[cur][2];
  btns[cur].setAttribute('aria-pressed','true');

  // barra fixa de compra (celular)
  var bar = document.getElementById('sticky');
  var heroCta = document.querySelector('.hero [data-cta]');
  var offer = document.getElementById('oferta');
  var heroGone = false, offerIn = false;
  function upd(){
    var on = heroGone && !offerIn;
    bar.classList.toggle('show', on);
    bar.setAttribute('aria-hidden', on ? 'false':'true');
    bar.querySelector('a').tabIndex = on ? 0 : -1;
  }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function(e){ heroGone = !e[0].isIntersecting && e[0].boundingClientRect.top < 0; upd(); }).observe(heroCta);
    new IntersectionObserver(function(e){ offerIn = e[0].isIntersecting; upd(); }, {threshold:.15}).observe(offer);
  }
})();
</script>
